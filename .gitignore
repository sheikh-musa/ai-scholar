.DS_Store
*.local.md
.env
.env.*
*.log

# Node
node_modules/

# Python
__pycache__/
*.pyc

# Supabase CLI cache
supabase/.temp/

# Enrichment pipeline local state (checkpoints, run logs, dotfile artifacts)
scripts/.v4_*
scripts/.v5_*
scripts/.probe_*

# Runtime junk — process pids, translation/ingest checkpoints, rollback
# snapshots, and stderr logs. Local-only artifacts, never committed.
scripts/*.pid
scripts/.*.pid
scripts/*.checkpoint.json
scripts/.*.checkpoint.json
scripts/.asbab_retag_rollback/
logs/*.err

# Agent handoff artifacts — per-lane recycle handoffs, never committed (CAI-944).
# Keep the exclusion in TRACKED history so a fresh worktree inherits it (the gap
# CAI-943 left when a lane excluded it only via per-clone .git/info/exclude).
*handoff-NOW.md
